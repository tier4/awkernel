    // For x86_64
    "rust-analyzer.cargo.buildScripts.overrideCommand": [
        "cargo",
        "+nightly-2026-07-20",
        "check_no_std",
        "--target=targets/x86_64-kernel.json",
        "--features=x86",
    ],
